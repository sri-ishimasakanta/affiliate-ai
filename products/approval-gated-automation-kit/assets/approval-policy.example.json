{
  "schema": "approval-policy-example/2",
  "about": "設定の例です。これは特定のツールがそのまま読み込む設定ファイルではありません。自分の自動化の方針を整理し、実装へ落とし込むときのひな形です (項目の名前は説明のためのもの)。既定はすべて安全側 (無効・人の承認あり) にしてあり、すべての書き込み先が enabled: false です。秘密 (パスワード・トークン) はここに書かず、環境ごとの秘密の置き場に置いてください。数値は例であり、推奨値ではありません。",
  "targets": [
    {
      "name": "article_body_update",
      "stage": "C",
      "approval": {"required": true, "bound_to": "content_hash", "invalidated_when_content_changes": true},
      "before_write": ["compare_remote_state_with_approval"],
      "after_write": ["read_back_and_compare"],
      "on_unknown_outcome": "record_as_unknown_not_success",
      "enabled": false
    },
    {
      "name": "social_post_publication",
      "stage": "B",
      "approval": {"required": true, "bound_to": "content_hash", "meaning": "may_publish_not_publish_now"},
      "limits": {"max_per_day": 3, "min_gap_minutes": 120, "catch_up_burst": false},
      "enabled": false
    },
    {
      "name": "generated_image_or_attachment",
      "stage": "C",
      "approval": {
        "required": true,
        "bound_to": "file_content_hash",
        "path_or_filename_is_not_the_approval_target": true,
        "invalidated_when_content_changes": true
      },
      "snapshot": {
        "enabled": true,
        "store": "approved-snapshots/<item-id>/",
        "file_name": "<sha256>.<ext>",
        "overwrite": false,
        "delete": false,
        "verify_after_write": ["bytes", "sha256", "file_type"],
        "canonical_after_approval": "snapshot"
      },
      "before_publish": ["verify_snapshot_matches_approved_hash"],
      "on_content_change": "reopen_resubmit_reapprove",
      "on_snapshot_failure": "do_not_approve",
      "enabled": false
    },
    {
      "name": "first_automatic_email",
      "stage": "D",
      "approval": {"required": true, "first_run_observed_by_human": true},
      "enabled": false
    },
    {
      "name": "tracking_link_change",
      "stage": "E",
      "enabled": false,
      "note": "自動では行わない"
    }
  ],
  "suggestions": {"approve_all": false, "suggestion_approval_writes_anything": false},
  "approvals": {
    "history": "append_only",
    "superseded_approvals_are_kept": true,
    "retrospective_approval": {"allowed": true, "must_be_marked_as_after_publication": true, "rewrite_times": false}
  },
  "notifications": {"only_when_action_needed": true, "group_same_problem": true, "renotify_after_hours": 168, "auto_resolve": true},
  "records": {"append_only": true, "corrections_supersede": true}
}
