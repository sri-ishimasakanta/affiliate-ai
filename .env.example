# アプリケーション
APP_NAME=affiliate-ai
DEBUG=false

# データベース
# 開発段階では SQLite を利用する。
DATABASE_URL=sqlite:///./affiliate_ai.db
DATABASE_ECHO=false

# PostgreSQL へ切り替える場合は以下のように設定する。
# DATABASE_URL=postgresql+psycopg://affiliate:affiliate@localhost:5432/affiliate_ai

# Google Ads (Keyword Historical Metrics 収集)。
# 未設定でもアプリ・既存 API は起動する。search_demand collector を使う場合のみ必須。
# 実値は絶対にコミットしないこと (.env は .gitignore 済み)。
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# 任意 (MCC 経由の場合)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# ターゲティング (未設定なら日本向け default: 2392 / 1005)
GOOGLE_ADS_GEO_TARGET_ID=2392
GOOGLE_ADS_LANGUAGE_ID=1005

# WordPress 連携 (Phase 3C-5)。未設定でもアプリ・dry-run preview は動く。
# 実際の投稿を行うフェーズでのみ必須。
# WORDPRESS_APP_PASSWORD は WordPress の「アプリケーションパスワード」であり、
# ログインパスワードではない。実値は絶対にコミットしないこと (.env は .gitignore 済み)。
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_DEFAULT_POST_STATUS=draft
WORDPRESS_VERIFY_TLS=true
