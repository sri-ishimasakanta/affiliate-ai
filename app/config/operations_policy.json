{
  "policy_version": "c8.6",
  "notes": [
    "Operational defaults for the recurring measurement pipeline. These are our own",
    "operating choices (windows, lags, staleness tolerances), NOT guarantees from",
    "Google or any provider about when data will arrive.",
    "Conservative on purpose: it is better to stay quiet than to page a human about",
    "a provider's normal reporting delay.",
    "This pipeline never writes article content and never calls /go/<token>.",
    "C8.5: source freshness is judged on IMPORT COVERAGE (did a successful import reach the expected date?), never on DATA ACTIVITY (is the newest metric row recent?). A low-traffic site legitimately produces no new rows for days.",
    "C8.6: the scheduled action is a first-party launcher (scripts/run_operations_task.cmd) so the schtasks /TR argument never contains nested quotes. Daily runs MON-SAT and weekly runs SUN, so Sunday never executes the pipeline twice."
  ],
  "timezone": "Asia/Tokyo",
  "imports": {
    "search_console": {
      "days": 30,
      "lag_days": 1,
      "expected_lag_days": 3,
      "refresh_stale_after_hours": 48,
      "coverage_stale_after_days": 3,
      "activity_quiet_after_days": 30
    },
    "ga4": {
      "days": 30,
      "lag_days": 1,
      "expected_lag_days": 2,
      "initial_grace_days": 7,
      "refresh_stale_after_hours": 48,
      "coverage_stale_after_days": 3,
      "activity_quiet_after_days": 30
    },
    "affiliate_clicks": {
      "page_limit": 1000,
      "refresh_stale_after_hours": 48,
      "coverage_stale_after_days": null,
      "activity_quiet_after_days": null
    },
    "make_commissions": {
      "days": 30,
      "refresh_stale_after_hours": 72,
      "coverage_stale_after_days": 3,
      "activity_quiet_after_days": null
    }
  },
  "candidates": {
    "window_days": 30,
    "persist_on_daily": true,
    "persist_on_weekly": true
  },
  "indexability": {
    "inspect_on_daily": false,
    "inspect_on_weekly": true
  },
  "alerts": {
    "cooldown_hours": 24,
    "notify_min_severity": "warning",
    "notify_candidate_min_priority": "medium",
    "persisted_candidate_threshold": 3,
    "max_consecutive_failures": 3,
    "activity_alerts_enabled": false
  },
  "severity": {
    "IMPORT_FAILURE": "error",
    "DATA_STALE": "warning",
    "ARTICLE_HTTP_HEALTH": "error",
    "INDEXABILITY_REGRESSION": "warning",
    "MONETIZATION_STRUCTURE_REGRESSION": "error",
    "CANDIDATE_CHANGE": "info",
    "AUTOMATION_HEALTH": "error",
    "NO_RECENT_ACTIVITY": "info"
  },
  "locking": {
    "stale_lock_after_minutes": 120
  },
  "retries": {
    "enabled": false,
    "max_attempts": 1
  },
  "scheduler": {
    "recommendation": "windows_task_scheduler",
    "daily_days": "MON,TUE,WED,THU,FRI,SAT",
    "daily_at": "06:30",
    "weekly_day": "SUN",
    "weekly_at": "07:30",
    "log_directory": "D:\\Logs\\affiliate-ai",
    "run_level": "LIMITED",
    "launcher": "scripts\\run_operations_task.cmd"
  }
}
